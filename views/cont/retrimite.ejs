<%- include('../partials/header', { titluPagina: 'Link nou de confirmare' }) %>

<div class="card shadow-sm mx-auto latime-cont">
  <div class="card-body p-4 p-md-5">
    <h1 class="h4 mb-1 text-center">Link nou de confirmare</h1>
    <% if (trimis) { %>
      <div class="alert alert-success mt-3 mb-0" role="status">Dacă există un cont neconfirmat cu adresa <strong><%= email %></strong>, ți-am trimis un link nou. Linkurile trimise înainte nu mai sunt valabile.</div>
      <p class="text-center small mt-3 mb-0"><a href="/autentificare">Înapoi la autentificare</a></p>
    <% } else { %>
      <p class="text-body-secondary text-center mb-4">Scrie adresa cu care ți-ai făcut contul.</p>
      <form method="post" action="/confirmare/retrimite" novalidate>
        <%- include('../partials/csrf') %>
        <div class="mb-4">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control" id="email" name="email" value="<%= email %>" autocomplete="email" required autofocus>
        </div>
        <button class="btn btn-primary w-100" type="submit">Trimite linkul</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
