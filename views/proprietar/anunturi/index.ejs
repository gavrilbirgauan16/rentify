<%# "Anunturile mele": anunturile proprietarului conectat si cate anunturi active mai permite planul. %>
<%- include('../../partials/header', { titluPagina: 'Anunțurile mele' }) %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
  <h1 class="h3 mb-0">Anunțurile mele</h1>
  <% if (areProprietatiActive) { %>
  <a class="btn btn-primary" href="/proprietar/anunturi/create">+ Adaugă anunț</a>
  <% } else { %>
  <a class="btn btn-outline-primary" href="/proprietar/proprietati">Adaugă întâi o proprietate</a>
  <% } %>
</div>

<!-- Cat permite planul. Un anunt nou se poate salva oricand ca Ciorna; limita conteaza doar la publicare. -->
<div class="alert <%= limita.poateAdauga ? 'alert-light border' : 'alert-warning' %>" role="status">
  <% if (limita.plan) { %>
    Plan <strong><%= limita.plan %></strong>:
    <% if (limita.maxim === null) { %><strong><%= limita.folosit %></strong> anunțuri publicate (fără limită).
    <% } else { %><strong><%= limita.text %></strong> anunțuri publicate.<% } %>
    <span class="text-body-secondary small">(Se numără anunțurile active și cele care așteaptă aprobarea.)</span>
  <% } else { %>
    Nu ai un abonament în curs.
  <% } %>
  <% if (textLimita) { %><div class="small mt-1"><%= textLimita %> Anunțurile noi le poți salva ca Ciornă.</div><% } %>
</div>

<% if (anunturi.length === 0) { %>
  <div class="card card-body shadow-sm text-center py-5">
    <p class="mb-1 fw-semibold">Nu ai încă niciun anunț.</p>
    <p class="text-body-secondary mb-0">Un anunț prezintă una dintre proprietățile tale: preț, descriere și poze.</p>
  </div>
<% } else { %>
  <div class="d-grid gap-3">
    <% anunturi.forEach(function(a) { %>
    <div class="card shadow-sm">
      <div class="row g-0">
        <div class="col-4 col-md-2">
          <% if (a.primaImagine) { %>
            <img src="<%= a.primaImagine %>" alt="<%= a.titlu %>" class="img-fluid rounded-start h-100 object-fit-cover" style="max-height: 140px; width: 100%;">
          <% } else { %>
            <div class="bg-body-secondary h-100 d-flex align-items-center justify-content-center text-body-secondary small rounded-start" style="min-height: 100px;">fără poze</div>
          <% } %>
        </div>
        <div class="col-8 col-md-10">
          <div class="card-body py-2 py-md-3">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
              <h2 class="h6 mb-0"><%= a.titlu %></h2>
              <span class="badge text-bg-<%= a.culoareStare %>"><%= a.stareAfisata %></span>
            </div>
            <p class="text-body-secondary small mb-2">
              <%= a.tipAfisat %> · <strong><%= a.pretAfisat %></strong> · <%= a.proprietate_denumire %>, <%= a.proprietate_oras %>
              <% if (a.proprietateInactiva) { %><br><span class="text-danger">Proprietatea este inactivă.</span><% } %>
              <% if (a.esteInAsteptare) { %><br><span class="text-info-emphasis">Așteaptă aprobarea administratorului.</span><% } %>
              <% if (a.esteRespins) { %><br><span class="text-danger"><strong>Respins:</strong> <%= a.motiv_respingere %> Corectează și retrimite.</span><% } %>
            </p>
            <div class="d-flex flex-wrap gap-2">
              <a class="btn btn-sm btn-primary" href="/proprietar/anunturi/<%= a.id %>/edit">Editează</a>
              <%
                // Butonul potrivit starii: Activ -> Dezactiveaza; In asteptare -> Retrage; Respins -> Retrimite; altfel -> Publica.
                const buton = a.esteActiv ? { actiune: 'dezactiveaza', text: 'Dezactivează', clasa: 'btn-outline-danger' }
                  : a.esteInAsteptare ? { actiune: 'dezactiveaza', text: 'Retrage', clasa: 'btn-outline-secondary' }
                  : a.esteRespins ? { actiune: 'activeaza', text: 'Retrimite', clasa: 'btn-outline-success' }
                  : { actiune: 'activeaza', text: 'Publică', clasa: 'btn-outline-success' };
              %>
              <form method="post" action="/proprietar/anunturi/<%= a.id %>/<%= buton.actiune %>" class="d-inline">
                <%- include('../../partials/csrf') %>
                <button type="submit" class="btn btn-sm <%= buton.clasa %>"><%= buton.text %></button>
              </form>
              <%# Stergerea cere confirmare: o fereastra Bootstrap (fara JavaScript scris de noi, permis de CSP). %>
              <button type="button" class="btn btn-sm btn-link text-danger ms-auto" data-bs-toggle="modal" data-bs-target="#sterge-<%= a.id %>">Șterge</button>
            </div>
            <div class="modal fade" id="sterge-<%= a.id %>" tabindex="-1" aria-labelledby="titlu-sterge-<%= a.id %>" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                  <div class="modal-header">
                    <h2 class="modal-title h5" id="titlu-sterge-<%= a.id %>">Ștergi anunțul?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Închide"></button>
                  </div>
                  <div class="modal-body">
                    <p class="mb-2">„<strong><%= a.titlu %></strong>” dispare de pe site și din lista ta.</p>
                    <p class="mb-0 text-body-secondary small">Nu îl mai poți aduce înapoi.
                      <% if (a.esteActiv || a.esteInAsteptare) { %>Dacă vrei doar să-l scoți de pe site pentru o vreme,
                      folosește <strong><%= a.esteActiv ? 'Dezactivează' : 'Retrage' %></strong>.<% } %></p>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Renunță</button>
                    <form method="post" action="/proprietar/anunturi/<%= a.id %>/sterge" class="d-inline">
                      <%- include('../../partials/csrf') %>
                      <button type="submit" class="btn btn-danger">Da, șterge</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>

<%- include('../../partials/footer') %>
