<%# Adaugarea si editarea unui anunt de catre proprietar (aceeasi pagina; titlul si adresa vin din controller).
    Formularul e cel de la admin, fara bifa "Promovat" si doar cu proprietatile lui. %>
<%- include('../../partials/header', { titluPagina: titlu }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/proprietar/anunturi">Anunțurile mele</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= a.id ? a.titlu : 'Adaugă' %></li>
  </ol>
</nav>

<div class="card shadow-sm">
  <div class="card-body p-3 p-md-4">
    <h1 class="h4 mb-2"><%= titlu %></h1>
    <% if (a.motiv_respingere) { %>
    <div class="alert alert-danger" role="alert">
      <strong>Anunțul a fost respins de administrator:</strong> <%= a.motiv_respingere %><br>
      Corectează-l și salvează cu „Publică” ca să-l trimiți din nou la aprobare.
    </div>
    <% } %>
    <p class="text-body-secondary small mb-4">
      <strong>Ciornă</strong> = salvat doar pentru tine · <strong>Publică</strong> = trimis administratorului, apare pe site după aprobare
      (în limita planului) · <strong>Inactiv</strong> = scos de pe site. Orice modificare de conținut a unui anunț publicat se verifică din nou.
    </p>
    <%- include('../../admin/anunturi/_formular', { actiune: actiune, inapoi: '/proprietar/anunturi', faraPromovare: true }) %>
  </div>
</div>

<%- include('../../partials/footer') %>
