<%# "Proprietatile mele": lista proprietarului conectat si cat ii mai permite planul. %>
<%- include('../../partials/header', { titluPagina: 'Proprietățile mele' }) %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
  <h1 class="h3 mb-0">Proprietățile mele</h1>
  <% if (limita.poateAdauga) { %>
  <a class="btn btn-primary" href="/proprietar/proprietati/create">+ Adaugă proprietate</a>
  <% } else { %>
  <button type="button" class="btn btn-primary" disabled>+ Adaugă proprietate</button>
  <% } %>
</div>

<!-- Cat permite planul -->
<div class="alert <%= limita.poateAdauga ? 'alert-light border' : 'alert-warning' %> d-flex flex-column flex-sm-row justify-content-between gap-1" role="status">
  <span>
    <% if (limita.plan) { %>
      Plan <strong><%= limita.plan %></strong>:
      <% if (limita.maxim === null) { %><strong><%= limita.folosit %></strong> proprietăți active (fără limită).
      <% } else { %><strong><%= limita.text %></strong> proprietăți active folosite.<% } %>
    <% } else { %>
      Nu ai un abonament în curs.
    <% } %>
  </span>
  <% if (!limita.poateAdauga) { %><span class="small"><%= textLimita %></span><% } %>
</div>

<% if (proprietati.length === 0) { %>
  <div class="card card-body shadow-sm text-center py-5">
    <p class="mb-1 fw-semibold">Nu ai adăugat încă nicio proprietate.</p>
    <p class="text-body-secondary mb-0">Adaugă locuința pe care vrei s-o închiriezi, apoi îi vei putea publica anunțul.</p>
  </div>
<% } else { %>
  <!-- Ecrane mari: tabel -->
  <div class="card shadow-sm d-none d-md-block">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">Denumire</th><th scope="col">Tip</th><th scope="col">Oraș</th>
            <th scope="col" class="text-center">Camere</th><th scope="col">Stare</th>
            <th scope="col" class="text-center">Anunțuri active</th><th scope="col" class="text-end">Acțiuni</th>
          </tr>
        </thead>
        <tbody>
          <% proprietati.forEach(function(p) { %>
          <tr>
            <td class="fw-semibold"><%= p.denumire %></td>
            <td><%= p.tipAfisat %></td>
            <td><%= p.oras %><%= p.zona ? ', ' + p.zona : '' %></td>
            <td class="text-center"><%= p.nr_camere %></td>
            <td><span class="badge text-bg-<%= p.culoareStare %>"><%= p.stareAfisata %></span></td>
            <td class="text-center"><%= p.anunturi_active %></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-primary" href="/proprietar/proprietati/<%= p.id %>/edit">Editează</a>
              <%- include('../../admin/proprietati/_buton_stare', { p: p, inapoi: '/proprietar/proprietati', baza: '/proprietar/proprietati', clase: 'btn-sm' }) %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Telefon: carduri -->
  <div class="d-md-none d-grid gap-3">
    <% proprietati.forEach(function(p) { %>
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-1">
          <h2 class="h6 mb-0"><%= p.denumire %></h2>
          <span class="badge text-bg-<%= p.culoareStare %>"><%= p.stareAfisata %></span>
        </div>
        <p class="text-body-secondary small mb-3">
          <%= p.tipAfisat %> · <%= p.oras %> · <%= p.nr_camere %> <%= Number(p.nr_camere) === 1 ? 'cameră' : 'camere' %> · anunțuri active: <%= p.anunturi_active %>
        </p>
        <div class="d-grid gap-2 d-sm-flex">
          <a class="btn btn-primary" href="/proprietar/proprietati/<%= p.id %>/edit">Editează</a>
          <%- include('../../admin/proprietati/_buton_stare', { p: p, inapoi: '/proprietar/proprietati', baza: '/proprietar/proprietati' }) %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>

<%- include('../../partials/footer') %>
