<%# Adaugarea si editarea unei proprietati de catre proprietar (aceeasi pagina; titlul si adresa vin din controller).
    Formularul e cel de la admin, fara alegerea proprietarului. %>
<%- include('../../partials/header', { titluPagina: titlu }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/proprietar/proprietati">Proprietățile mele</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= p.id ? p.denumire : 'Adaugă' %></li>
  </ol>
</nav>

<div class="card shadow-sm">
  <div class="card-body p-3 p-md-4">
    <h1 class="h4 mb-4"><%= titlu %></h1>
    <% if (p.stare === 'inactiv') { %>
    <div class="alert alert-secondary" role="status">Proprietatea este inactivă. O poți activa din lista proprietăților, dacă planul tău mai permite.</div>
    <% } %>
    <%- include('../../admin/proprietati/_formular', { actiune: actiune, inapoi: '/proprietar/proprietati' }) %>
  </div>
</div>

<%- include('../../partials/footer') %>
