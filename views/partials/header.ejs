<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <!-- Spune telefonului sa afiseze pagina la latimea ecranului (fara asta nu e responsive) -->
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titluPagina !== 'undefined' ? titluPagina + ' – ' : '' %>Rentify</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-body-tertiary">
  <nav class="navbar navbar-expand-xl navbar-dark bara-rentify">
    <div class="container-fluid px-3 px-md-4 px-xl-5">
      <a class="navbar-brand fw-semibold" href="/">Rentify<% if (utilizator && utilizator.rol === 'admin') { %> <span class="fw-normal opacity-75">Admin</span><% } %></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#meniu"
              aria-controls="meniu" aria-expanded="false" aria-label="Deschide meniul">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="meniu">
        <%
          // Meniul depinde de rol. Sectiunile fara adresa (href: null) nu sunt gata inca.
          const meniuri = {
            admin: [
              { cheie: 'panou', text: 'Panou', href: '/admin' },
              { cheie: 'proprietati', text: 'Proprietăți', href: '/admin/proprietati' },
              { cheie: 'anunturi', text: 'Anunțuri', href: '/admin/anunturi' },
              { cheie: 'utilizatori', text: 'Utilizatori', href: '/admin/utilizatori' },
              { cheie: 'abonamente', text: 'Abonamente', href: '/admin/abonamente' },
              { cheie: 'planuri', text: 'Planuri', href: '/admin/planuri' },
              { cheie: 'jurnal', text: 'Jurnal', href: '/admin/jurnal' },
            ],
            proprietar: [
              { cheie: 'proprietati', text: 'Proprietățile mele', href: null },
              { cheie: 'anunturi', text: 'Anunțurile mele', href: null },
              { cheie: 'abonament', text: 'Abonament', href: null },
            ],
            chirias: [
              { cheie: 'cauta', text: 'Caută locuință', href: null },
              { cheie: 'favorite', text: 'Favorite', href: null },
            ],
          };
          const meniu = utilizator ? meniuri[utilizator.rol] || [] : [];
          const curenta = typeof sectiune !== 'undefined' ? sectiune : '';
        %>
        <ul class="navbar-nav ms-auto">
          <% meniu.forEach(function(m) { %>
          <li class="nav-item">
            <% if (!m.href) { %>
              <span class="nav-link disabled" aria-disabled="true"><%= m.text %></span>
            <% } else if (m.cheie === curenta) { %>
              <a class="nav-link active" aria-current="page" href="<%= m.href %>"><%= m.text %></a>
            <% } else { %>
              <a class="nav-link" href="<%= m.href %>"><%= m.text %></a>
            <% } %>
          </li>
          <% }) %>
        </ul>

        <% if (utilizator && utilizator.rol === 'admin') { %>
        <!-- Cautarea rapida: utilizatori, proprietati, anunturi -->
        <form class="d-flex ms-xl-3 my-2 my-xl-0" role="search" method="get" action="/admin/cautare">
          <input class="form-control form-control-sm cautare-antet" type="search" name="q" placeholder="Caută…" aria-label="Caută în utilizatori, proprietăți și anunțuri">
        </form>
        <% } %>

        <!-- Contul: numele si iesirea (sau linkul de autentificare) -->
        <div class="d-xl-flex align-items-center ms-xl-3 pt-2 pt-xl-0 border-top cont-bara">
          <% if (utilizator) { %>
            <span class="navbar-text me-xl-2 d-block d-xl-inline small text-nowrap">
              <%= utilizator.nume %> <span class="opacity-75">(<%= utilizator.rol %>)</span>
            </span>
            <a class="btn btn-sm btn-link link-light <%= curenta === 'cont' ? '' : 'link-opacity-75' %> link-opacity-100-hover px-0 me-xl-3 text-nowrap" href="/cont"<%- curenta === 'cont' ? ' aria-current="page"' : '' %>>Contul meu</a>
            <form method="post" action="/iesire" class="d-inline">
              <%- include('csrf') %>
              <button type="submit" class="btn btn-sm btn-outline-light my-2 my-xl-0">Ieșire</button>
            </form>
          <% } else { %>
            <% if (curenta !== 'autentificare') { %>
            <a class="btn btn-sm btn-link link-light link-opacity-75 link-opacity-100-hover px-0 me-3 text-nowrap" href="/autentificare">Autentificare</a>
            <% } %>
            <% if (curenta !== 'inregistrare') { %>
            <a class="btn btn-sm btn-outline-light my-2 my-xl-0" href="/inregistrare">Cont nou</a>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Adminul lucreaza cu tabele mari: zona de continut e mai lata (dar nu nelimitata) -->
  <main class="<%= utilizator && utilizator.rol === 'admin' ? 'container-fluid container-admin' : 'container' %> py-4">
    <% if (mesaj) { %>
    <div class="alert alert-<%= tipMesaj %> alert-dismissible fade show" role="alert">
      <%= mesaj %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Închide"></button>
    </div>
    <% } %>