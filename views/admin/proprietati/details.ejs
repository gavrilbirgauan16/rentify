<%- include('../../partials/header', { titluPagina: p.denumire }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/admin/proprietati">Proprietăți</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= p.denumire %></li>
  </ol>
</nav>

<div class="card shadow-sm">
  <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
    <h1 class="h4 mb-0"><%= p.denumire %></h1>
    <span class="badge text-bg-<%= p.culoareStare %> fs-6"><%= p.stareAfisata %></span>
  </div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-4">Tip</dt><dd class="col-sm-8"><%= p.tipAfisat %></dd>
      <dt class="col-sm-4">Județ</dt><dd class="col-sm-8"><%= p.judet %></dd>
      <dt class="col-sm-4">Oraș</dt><dd class="col-sm-8"><%= p.oras %></dd>
      <dt class="col-sm-4">Zonă</dt><dd class="col-sm-8"><%= p.zona || '–' %></dd>
      <dt class="col-sm-4">Număr de camere</dt><dd class="col-sm-8"><%= p.nr_camere %></dd>
      <dt class="col-sm-4">Suprafață</dt><dd class="col-sm-8"><%= p.suprafata_mp ? p.suprafata_mp + ' mp' : '–' %></dd>
      <dt class="col-sm-4">Maxim locatari</dt><dd class="col-sm-8"><%= p.max_locatari %></dd>
      <dt class="col-sm-4">Balcon</dt><dd class="col-sm-8"><%= p.are_balcon ? 'Da' : 'Nu' %></dd>
      <dt class="col-sm-4">Proprietar</dt><dd class="col-sm-8 mb-0"><%= p.proprietar_nume %></dd>
    </dl>
  </div>
  <div class="card-footer bg-white d-grid gap-2 d-sm-flex py-3">
    <a class="btn btn-primary" href="/admin/proprietati/<%= p.id %>/edit">Editează</a>
    <%- include('_buton_stare', { p: p, inapoi: '/admin/proprietati/' + p.id, clase: 'w-100' }) %>
    <a class="btn btn-outline-secondary ms-sm-auto" href="/admin/proprietati">Înapoi la listă</a>
  </div>
</div>

<%- include('../../partials/footer') %>