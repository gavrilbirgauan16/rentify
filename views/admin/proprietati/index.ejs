<%- include('../../partials/header', { titluPagina: 'Proprietăți' }) %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
  <h1 class="h3 mb-0">Proprietăți</h1>
  <a class="btn btn-primary" href="/admin/proprietati/create">+ Adaugă proprietate</a>
</div>

<% if (proprietati.length === 0) { %>
  <div class="card card-body text-center text-body-secondary">Nu există încă nicio proprietate.</div>
<% } else { %>

  <!-- Laptop si monitor: tabel (ascuns pe ecrane mici) -->
  <div class="card shadow-sm d-none d-md-block">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">Denumire</th><th scope="col">Tip</th><th scope="col">Oraș</th>
            <th scope="col" class="text-center">Camere</th><th scope="col" class="text-center">Balcon</th>
            <th scope="col">Stare</th><th scope="col">Proprietar</th><th scope="col" class="text-end">Acțiuni</th>
          </tr>
        </thead>
        <tbody>
          <% proprietati.forEach(function(p) { %>
          <tr>
            <td class="fw-semibold"><%= p.denumire %></td>
            <td><%= p.tipAfisat %></td>
            <td><%= p.oras %></td>
            <td class="text-center"><%= p.nr_camere %></td>
            <td class="text-center"><%= p.are_balcon ? 'Da' : 'Nu' %></td>
            <td><span class="badge text-bg-<%= p.culoareStare %>"><%= p.stareAfisata %></span></td>
            <td><%= p.proprietar_nume %></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-primary" href="/admin/proprietati/<%= p.id %>">Detalii</a>
              <a class="btn btn-sm btn-primary" href="/admin/proprietati/<%= p.id %>/edit">Editează</a>
              <%- include('_buton_stare', { p: p, inapoi: '/admin/proprietati', clase: 'btn-sm' }) %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Telefon: carduri (ascunse pe ecrane mari) -->
  <div class="d-md-none d-grid gap-3">
    <% proprietati.forEach(function(p) { %>
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-1">
          <h2 class="h6 mb-0"><%= p.denumire %></h2>
          <span class="badge text-bg-<%= p.culoareStare %>"><%= p.stareAfisata %></span>
        </div>
        <p class="text-body-secondary small mb-3">
          <%= p.tipAfisat %> · <%= p.oras %> · <%= p.nr_camere %> <%= Number(p.nr_camere) === 1 ? "cameră" : "camere" %> · balcon: <%= p.are_balcon ? 'da' : 'nu' %><br>
          Proprietar: <%= p.proprietar_nume %>
        </p>
        <div class="d-grid gap-2 d-sm-flex">
          <a class="btn btn-outline-primary" href="/admin/proprietati/<%= p.id %>">Detalii</a>
          <a class="btn btn-primary" href="/admin/proprietati/<%= p.id %>/edit">Editează</a>
          <%- include('_buton_stare', { p: p, inapoi: '/admin/proprietati', clase: 'w-100' }) %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>

<%- include('../../partials/footer') %>