<%- include('../../partials/header', { titluPagina: 'Planuri de abonament' }) %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
  <h1 class="h3 mb-0">Planuri de abonament</h1>
  <a class="btn btn-primary" href="/admin/planuri/create?rol=<%= rol %>">+ Adaugă plan</a>
</div>

<!-- Tab-urile: planurile pentru proprietari si pentru chiriasi -->
<ul class="nav nav-pills mb-4">
  <% roluri.forEach(function(r) { %>
  <li class="nav-item">
    <a class="nav-link <%= r === rol ? 'active' : '' %>" <%- r === rol ? 'aria-current="page"' : '' %> href="/admin/planuri?rol=<%= r %>"><%= eticheteRol[r] %></a>
  </li>
  <% }) %>
</ul>

<% if (planuri.length === 0) { %>
  <div class="card card-body text-center text-body-secondary">Nu există niciun plan pentru <%= eticheteRol[rol].toLowerCase() %>.</div>
<% } else { %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 align-items-stretch">
    <% planuri.forEach(function(p) { %>
    <div class="col">
      <div class="card h-100 card-plan <%= p.recomandat ? 'card-plan-recomandat' : '' %> <%= p.activ ? '' : 'card-plan-inactiv' %>">
        <% if (p.recomandat) { %><div class="eticheta-recomandat">Recomandat</div><% } %>
        <div class="card-body d-flex flex-column p-4">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <h2 class="h4 mb-1"><%= p.nume %></h2>
            <% if (!p.activ) { %><span class="badge text-bg-secondary">Inactiv</span><% } %>
          </div>
          <p class="text-body-secondary small mb-3"><%= p.descriere %></p>

          <!-- Pretul -->
          <% if (p.esteGratuit) { %>
            <p class="pret-plan mb-1">Gratuit</p>
            <p class="small text-body-secondary mb-4">fără card, fără obligații</p>
          <% } else { %>
            <p class="pret-plan mb-1"><%= p.pretLunarAfisat %> <span class="fs-6 fw-normal text-body-secondary">/ lună</span></p>
            <p class="small text-body-secondary mb-4">
              sau <%= p.pretAnualAfisat %> / an
              <% if (p.economieAnuala) { %><span class="badge bg-success-subtle text-success-emphasis ms-1">economisești <%= p.economieAnuala %></span><% } %>
            </p>
          <% } %>

          <!-- Ce include -->
          <ul class="list-unstyled lista-beneficii mb-4">
            <% p.caracteristici.forEach(function(c) { %>
            <li class="<%= c.inclus ? '' : 'neinclus' %>">
              <svg class="semn" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <% if (c.inclus) { %><path d="M13.485 3.929a1 1 0 0 1 0 1.414l-6.364 6.364a1 1 0 0 1-1.414 0L2.515 8.515a1 1 0 1 1 1.414-1.414l2.485 2.485 5.657-5.657a1 1 0 0 1 1.414 0z"/><% } else { %><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/><% } %>
              </svg>
              <span class="visually-hidden"><%= c.inclus ? 'Inclus:' : 'Nu include:' %></span>
              <%= c.text %>
            </li>
            <% }) %>
          </ul>

          <div class="mt-auto">
            <p class="small text-body-secondary mb-2"><%= p.abonati %> <%= p.abonati === 1 ? 'abonament activ' : 'abonamente active' %></p>
            <div class="d-grid gap-2 d-sm-flex">
              <a class="btn btn-primary flex-fill" href="/admin/planuri/<%= p.id %>/edit">Editează</a>
              <form method="post" action="/admin/planuri/<%= p.id %>/<%= p.activ ? 'dezactiveaza' : 'activeaza' %>" class="flex-fill d-grid">
                <%- include('../../partials/csrf') %>
                <button type="submit" class="btn <%= p.activ ? 'btn-outline-danger' : 'btn-outline-success' %>"><%= p.activ ? 'Dezactivează' : 'Activează' %></button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>

<%- include('../../partials/footer') %>