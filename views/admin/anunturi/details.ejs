<%- include('../../partials/header', { titluPagina: a.titlu }) %>

<nav aria-label="breadcrumb"><ol class="breadcrumb small mb-2">
  <li class="breadcrumb-item"><a href="/admin/anunturi">Anunțuri</a></li>
  <li class="breadcrumb-item active" aria-current="page"><%= a.titlu %></li>
</ol></nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-1"><%= a.titlu %></h1>
    <span class="badge text-bg-<%= a.culoareStare %>"><%= a.stareAfisata %></span>
    <% if (a.promovat) { %><span class="badge text-bg-info">Promovat</span><% } %>
    <% if (a.proprietateInactiva) { %><span class="badge text-bg-danger">Proprietate inactivă</span><% } %>
  </div>
  <div class="d-flex flex-column flex-sm-row gap-2">
    <%- include('_buton_suna', { a: a }) %>
    <% if (!a.esteInAsteptare) { %>
    <a class="btn btn-primary" href="/admin/anunturi/<%= a.id %>/edit">Editează</a>
    <%- include('_buton_stare', { a: a, inapoi: '/admin/anunturi/' + a.id }) %>
    <% } %>
  </div>
</div>

<% if (a.esteInAsteptare) { %>
<!-- Moderarea: anuntul asteapta aprobarea -->
<div class="card border-warning shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h5 mb-1">Așteaptă aprobarea</h2>
    <p class="text-body-secondary small mb-3">Verifică textul, prețul și pozele. Aprobat, anunțul apare imediat pe site; proprietarul primește un email.</p>
    <div class="row g-3 align-items-start">
      <div class="col-md-4">
        <form method="post" action="/admin/anunturi/<%= a.id %>/aproba" class="d-grid">
          <%- include('../../partials/csrf') %>
          <input type="hidden" name="inapoi" value="/admin/anunturi/<%= a.id %>">
          <%# Varianta pe care o vede adminul acum: daca proprietarul schimba anuntul intre timp, aprobarea se opreste. %>
          <input type="hidden" name="versiune" value="<%= versiune %>">
          <button type="submit" class="btn btn-success">Aprobă</button>
        </form>
      </div>
      <div class="col-md-8">
        <form method="post" action="/admin/anunturi/<%= a.id %>/respinge">
          <%- include('../../partials/csrf') %>
          <label for="motiv" class="form-label small mb-1">Sau respinge, cu motivul (îl vede proprietarul):</label>
          <div class="input-group">
            <input type="text" class="form-control" id="motiv" name="motiv" minlength="5" maxlength="300" required placeholder="ex. Lipsesc pozele camerelor">
            <button type="submit" class="btn btn-outline-danger">Respinge</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<% } else if (a.esteRespins) { %>
<div class="alert alert-danger" role="status"><strong>Respins:</strong> <%= a.motiv_respingere %> <span class="small">(proprietarul îl poate corecta și retrimite)</span></div>
<% } else if (a.esteActiv) { %>
<details class="mb-4">
  <summary class="small text-body-secondary">Scoate anunțul de pe site, cu motiv (ex. conținut neadecvat)</summary>
  <form method="post" action="/admin/anunturi/<%= a.id %>/respinge" class="mt-2">
    <%- include('../../partials/csrf') %>
    <div class="input-group">
      <input type="text" class="form-control" name="motiv" minlength="5" maxlength="300" required placeholder="Motivul (îl vede proprietarul)" aria-label="Motivul respingerii">
      <button type="submit" class="btn btn-outline-danger">Respinge</button>
    </div>
  </form>
</details>
<% } %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm overflow-hidden">
      <%- include('_continut', { a: a }) %>
    </div>
  </div>
  <div class="col-lg-4 d-grid gap-4 align-content-start">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h5 mb-3">Pe scurt</h2>
        <dl class="row mb-0 small">
          <dt class="col-6">Adăugat</dt><dd class="col-6"><%= a.creatLaAfisat %></dd>
          <dt class="col-6">Imagini</dt><dd class="col-6"><%= a.imagini.length %></dd>
          <dt class="col-6">Alte anunțuri</dt><dd class="col-6"><a href="/admin/anunturi?proprietate=<%= a.proprietate_id %>">ale acestei proprietăți</a></dd>
        </dl>
      </div>
    </div>
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h5 mb-3">Istoric acțiuni</h2>
        <%- include('../_istoric', { istoric: istoric }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
