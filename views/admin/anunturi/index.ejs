<%- include('../../partials/header', { titluPagina: 'Anunțuri' }) %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
  <h1 class="h3 mb-0">Anunțuri</h1>
  <a class="btn btn-primary" href="/admin/anunturi/create">+ Adaugă anunț</a>
</div>

<% if (anunturi.length === 0) { %>
  <div class="card card-body text-center text-body-secondary">Nu există încă niciun anunț.</div>
<% } else { %>

  <!-- Laptop si monitor: tabel -->
  <div class="card shadow-sm d-none d-md-block">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">Anunț</th><th scope="col">Proprietate</th><th scope="col">Proprietar</th>
            <th scope="col">Tip</th><th scope="col" class="text-end">Preț</th>
            <th scope="col">Disponibil</th><th scope="col">Stare</th><th scope="col" class="text-end">Acțiuni</th>
          </tr>
        </thead>
        <tbody>
          <% anunturi.forEach(function(a) { %>
          <tr>
            <td>
              <!-- Clic pe imagine sau pe titlu: se deschide fereastra cu galeria si detaliile -->
              <button type="button" class="btn-deschide d-flex align-items-center gap-3 text-start"
                      data-bs-toggle="modal" data-bs-target="#anunt-<%= a.id %>">
                <% if (a.primaImagine) { %>
                  <img src="<%= a.primaImagine %>" alt="" class="miniatura rounded">
                <% } else { %>
                  <span class="miniatura miniatura-goala rounded">fără<br>imagine</span>
                <% } %>
                <span>
                  <span class="fw-semibold titlu-anunt"><%= a.titlu %></span>
                  <% if (a.promovat) { %><span class="badge text-bg-info ms-1">Promovat</span><% } %>
                  <% if (a.imagini.length > 1) { %><span class="d-block small text-body-secondary"><%= a.imagini.length %> imagini</span><% } %>
                </span>
              </button>
            </td>
            <td>
              <%= a.proprietate_denumire %>
              <div class="small text-body-secondary">
                <%= a.proprietate_oras %><% if (a.proprietateInactiva) { %> · <span class="text-danger">proprietate inactivă</span><% } %>
              </div>
            </td>
            <td><%= a.proprietar_nume %></td>
            <td><%= a.tipAfisat %></td>
                        <td class="text-end text-nowrap">
              <%= a.pretAfisat %>
              <% if (a.pretMinimPePersoana) { %><div class="small text-body-secondary">de la <%= a.pretMinimPePersoana %> / pers.</div><% } %>
              <% if (a.areReducereOPersoana) { %><div class="small text-success">1 pers.: <%= a.preturiPePersoane[0].pePersoana %></div><% } %>
            </td>
            <td><%= a.disponibilAfisat %></td>
            <td><span class="badge text-bg-<%= a.culoareStare %>"><%= a.stareAfisata %></span></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-primary" href="/admin/anunturi/<%= a.id %>/edit">Editează</a>
              <%- include('_buton_stare', { a: a, clase: 'btn-sm' }) %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Telefon: carduri cu imagine -->
  <div class="d-md-none d-grid gap-3">
    <% anunturi.forEach(function(a) { %>
    <div class="card shadow-sm overflow-hidden">
      <button type="button" class="btn-deschide" data-bs-toggle="modal" data-bs-target="#anunt-<%= a.id %>" aria-label="Deschide anunțul <%= a.titlu %>">
        <% if (a.primaImagine) { %>
          <img src="<%= a.primaImagine %>" alt="" class="imagine-card">
        <% } else { %>
          <span class="imagine-card miniatura-goala">fără imagine</span>
        <% } %>
      </button>
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
          <h2 class="h6 mb-0"><%= a.titlu %></h2>
          <span class="badge text-bg-<%= a.culoareStare %>"><%= a.stareAfisata %></span>
        </div>
                <p class="fw-semibold mb-1">
          <%= a.pretAfisat %>
          <% if (a.pretMinimPePersoana) { %><span class="small fw-normal text-body-secondary">· de la <%= a.pretMinimPePersoana %> / pers.</span><% } %>
        </p>
        <p class="text-body-secondary small mb-0">
          <%= a.tipAfisat %> · <%= a.proprietate_denumire %>, <%= a.proprietate_oras %><br>
          Proprietar: <%= a.proprietar_nume %> · disponibil: <%= a.disponibilAfisat %>
          <% if (a.proprietateInactiva) { %><br><span class="text-danger">Proprietate inactivă</span><% } %>
          <% if (a.promovat) { %><br><span class="badge text-bg-info mt-1">Promovat</span><% } %>
        </p>
        <div class="d-grid gap-2 d-sm-flex mt-3">
          <%- include('_buton_suna', { a: a }) %>
          <a class="btn btn-primary" href="/admin/anunturi/<%= a.id %>/edit">Editează</a>
          <%- include('_buton_stare', { a: a, clase: 'w-100' }) %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Ferestrele cu detalii (cate una pentru fiecare anunt, ascunse pana la clic) -->
  <% anunturi.forEach(function(a) { %>
    <%- include('_fereastra', { a: a }) %>
  <% }) %>
<% } %>

<%- include('../../partials/footer') %>