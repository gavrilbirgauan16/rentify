# Copiaza acest fisier ca ".env" si completeaza valorile tale.

# Conexiunea la PostgreSQL: utilizator, parola, server, port, baza de date
DATABASE_URL="postgresql://postgres:PAROLA_TA@localhost:5432/rentify_cf"

# Cheia cu care se semneaza cookie-ul de sesiune (minim 32 de caractere, aleatoare).
# Genereaza una cu:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="pune_aici_cheia_generata"
# Cheia pentru API: Post / Put pe /api/... cer antetul  x-api-key: <aceasta valoare>  (minim 32 de caractere).
# Genereaza una la fel ca SESSION_SECRET. Daca lipseste, API-ul merge doar pentru citire (GET).
API_KEY="pune_aici_alta_cheie_generata"
# Optional
# PORT=3000
# NODE_ENV=production