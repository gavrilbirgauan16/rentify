# Setarile pentru TESTELE DE INTEGRARE (npm run test:integrare).
# Copiaza acest fisier ca ".env.test" si pune parola ta de PostgreSQL (aceeasi ca in .env).
#
# ATENTIE: numele bazei TREBUIE sa se termine cu "_test". Testele sterg si refac complet aceasta baza,
# asa ca refuza sa porneasca pe orice alta baza (de ex. rentify_cf, unde sunt datele tale).
# Baza se creeaza singura la prima rulare.
DATABASE_URL="postgresql://postgres:PAROLA_TA@localhost:5432/rentify_test"

# Valori doar pentru teste (nu sunt secrete reale; minim 32 de caractere fiecare).
SESSION_SECRET="cheie-de-sesiune-doar-pentru-teste-0123456789"
API_KEY="cheie-api-doar-pentru-teste-0123456789abcdef"
